/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
